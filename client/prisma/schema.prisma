generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime traffic goes through Supabase's TRANSACTION-mode pooler
  // (port 6543, ?pgbouncer=true&connection_limit=1). Session mode (5432)
  // caps at 15 clients and Vercel's concurrent lambdas exhaust it, taking
  // the whole app down (EMAXCONNSESSION).
  url       = env("DATABASE_URL")
  // Schema changes (prisma db push in the build) need a direct/session
  // connection - DDL doesn't run reliably through the transaction pooler.
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String    @unique
  password      String
  role          String?   @default("personal")
  emailVerified DateTime? @db.Timestamp(6)
  createdAt     DateTime? @default(now()) @db.Timestamp(6)
  updatedAt     DateTime? @default(now()) @db.Timestamp(6)
  subscription  String?   @default("free")
  stripeCustomerId    String?   @unique
  stripeSubscriptionId String?   @unique
  tokens        Int?      @default(0)
  usage         Usage[]
  files         File[]
  courses       Course[]
  accounts      Account[]
  sessions      Session[]
  image         String?
  summaries     Summary[]
  quizzes       Quiz[]
  cheatSheets   CheatSheet[]
  feedback      Feedback[]
  workspaceArtifacts WorkspaceArtifact[]
  chatMessages  ChatMessage[]
  notifications Notification[]
  passwordResetTokens PasswordResetToken[] @relation("PasswordResetTokens")

  trialOffered  Boolean?  @default(false)
  trialExpires  DateTime? @db.Timestamp(6)
}

model Usage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @default(now()) @db.Timestamp(6)
}

model Course {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  files       File[]       @relation("CourseFiles")
  summaries   CourseSummary[] // Relație prin tabelă de joncțiune
  quizzes     Quiz[]
  cheatSheets CheatSheet[]
  createdAt   DateTime     @default(now()) @db.Timestamp(6)
  updatedAt   DateTime     @default(now()) @db.Timestamp(6)
}

model Summary {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String   @default("")
  content   String
  language  String   @default("en")
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses   CourseSummary[] // Relație prin tabelă de joncțiune
  fileId    String?  @unique @db.Uuid
  file      File?    @relation("SummaryFile", fields: [fileId], references: [id], onDelete: SetNull)
  artifacts    WorkspaceArtifact[]
  chatMessages ChatMessage[]
  createdAt DateTime @default(now()) @db.Timestamp(6)
}

// Artefacte de învățare generate la cerere pentru workspace (concepte, flashcards etc.)
model WorkspaceArtifact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  summaryId String   @db.Uuid
  summary   Summary  @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // 'concepts' | 'flashcards' | 'questions' | 'notes' | 'quiz'
  content   Json
  language  String   @default("en")
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)

  @@unique([summaryId, type])
  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  summaryId String   @db.Uuid
  summary   Summary  @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // 'user' | 'assistant'
  content   String
  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@index([summaryId, createdAt])
}

// Tabelă de joncțiune explicită pentru many-to-many
model CourseSummary {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId  String   @db.Uuid
  summaryId String   @db.Uuid
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  summary   Summary  @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now()) @db.Timestamp(6)

  @@unique([courseId, summaryId]) // Un rezumat nu poate fi adăugat de două ori în același curs
}

model Quiz {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questions Json
  courseId  String   @db.Uuid
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid  // Fixed: Added @db.Uuid annotation
  createdAt DateTime @default(now()) @db.Timestamp(6)
}

model CheatSheet {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content   String
  courseId  String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid  // Fixed: Added @db.Uuid annotation
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamp(6)
}

model File {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  size        Int
  pages       Int
  characters  Int
  summary     String
  isPremium   Boolean  @default(false)
  language    String   @default("en")
  quiz        Json?
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @db.Timestamp(6)
  courseId    String?  @db.Uuid
  course      Course?  @relation("CourseFiles", fields: [courseId], references: [id], onDelete: Cascade)
  extractedText String?
  // SHA-256 of the extracted text; used to detect re-uploads of the same
  // document so a user doesn't accumulate duplicate summaries.
  contentHash   String?
  summaryRec    Summary? @relation("SummaryFile")

  @@index([userId, contentHash])
}

// In-app notifications ("your summary is ready"). Text is NOT stored here -
// `type` + `payload` are rendered client-side through i18n so notifications
// follow the user's UI language.
model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // e.g. 'summary_ready'
  payload   Json?
  href      String?
  readAt    DateTime? @db.Timestamp(6)
  createdAt DateTime  @default(now()) @db.Timestamp(6)

  @@index([userId, createdAt])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String  @db.Uuid
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation("PasswordResetTokens", fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expires   DateTime @db.Timestamp(6)
  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@index([userId])
  @@index([token])
}

model Feedback {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rating    Int?     // 1-5 stars, optional for general feedback
  comment   String?  // Optional comment
  userId    String?  @db.Uuid // Optional user association
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamp(6)
}

model AnalyticsLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?  @db.Uuid
  eventType     String   // e.g., 'purchase_button_click', 'purchase_completed'
  eventCategory String   // e.g., 'ecommerce', 'engagement'
  eventLabel    String?  // e.g., 'premium_monthly', 'premium_annual'
  eventValue    Float?   // e.g., price amount
  metadata      Json?    // Additional data like plan details, transaction ID, etc.
  timestamp     DateTime @default(now()) @db.Timestamp(6)

  @@index([eventType])
  @@index([eventCategory])
  @@index([userId])
  @@index([timestamp])
}