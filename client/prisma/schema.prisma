generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String    @unique
  password      String
  role          String?   @default("personal")
  emailVerified DateTime? @db.Timestamp(6)
  createdAt     DateTime? @default(now()) @db.Timestamp(6)
  updatedAt     DateTime? @default(now()) @db.Timestamp(6)
  subscription  String?   @default("free")
  stripeCustomerId    String?   @unique
  stripeSubscriptionId String?   @unique
  tokens        Int?      @default(0)
  usage         Usage[]
  files         File[]
  courses       Course[]
  accounts      Account[]
  sessions      Session[]
  image         String?
  summaries     Summary[]
  quizzes       Quiz[]
  cheatSheets   CheatSheet[]
  feedback      Feedback[]

  trialOffered  Boolean?  @default(false)
  trialExpires  DateTime? @db.Timestamp(6)
}

model Usage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @default(now()) @db.Timestamp(6)
}

model Course {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  files       File[]       @relation("CourseFiles")
  summaries   CourseSummary[] // Relație prin tabelă de joncțiune
  quizzes     Quiz[]
  cheatSheets CheatSheet[]
  createdAt   DateTime     @default(now()) @db.Timestamp(6)
  updatedAt   DateTime     @default(now()) @db.Timestamp(6)
}

model Summary {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String   @default("")
  content   String
  language  String   @default("en")
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses   CourseSummary[] // Relație prin tabelă de joncțiune
  createdAt DateTime @default(now()) @db.Timestamp(6)
}

// Tabelă de joncțiune explicită pentru many-to-many
model CourseSummary {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId  String   @db.Uuid
  summaryId String   @db.Uuid
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  summary   Summary  @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now()) @db.Timestamp(6)

  @@unique([courseId, summaryId]) // Un rezumat nu poate fi adăugat de două ori în același curs
}

model Quiz {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questions Json
  courseId  String   @db.Uuid
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid  // Fixed: Added @db.Uuid annotation
  createdAt DateTime @default(now()) @db.Timestamp(6)
}

model CheatSheet {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content   String
  courseId  String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid  // Fixed: Added @db.Uuid annotation
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamp(6)
}

model File {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  size        Int
  pages       Int
  characters  Int
  summary     String
  isPremium   Boolean  @default(false)
  language    String   @default("en")
  quiz        Json?
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @db.Timestamp(6)
  courseId    String?  @db.Uuid
  course      Course?  @relation("CourseFiles", fields: [courseId], references: [id], onDelete: Cascade)
}

model Account {
  id                 String  @id @default(cuid())
  userId             String  @db.Uuid
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Feedback {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rating    Int?     // 1-5 stars, optional for general feedback
  comment   String?  // Optional comment
  userId    String?  @db.Uuid // Optional user association
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamp(6)
}