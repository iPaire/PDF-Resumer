# ============================================
# STRIPE CONFIGURATION
# ============================================
# IMPORTANT: See STRIPE_SETUP.md for detailed setup instructions
# Get API keys from https://dashboard.stripe.com/apikeys

# Stripe API Keys
# Use test keys (sk_test_ / pk_test_) for development
# Use live keys (sk_live_ / pk_live_) for production
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Stripe Webhook Secret (get from https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs for USD (United States Dollar)
# Create these at https://dashboard.stripe.com/products
# Each product needs a price for monthly and annual subscriptions
STRIPE_PREMIUM_PRICE_ID_USD=price_your_monthly_usd_price_id
STRIPE_PREMIUM_ANNUAL_PRICE_ID_USD=price_your_annual_usd_price_id

# Stripe Price IDs for EUR (Euro - Used for ES, DE, FR locales)
STRIPE_PREMIUM_PRICE_ID_EUR=price_your_monthly_eur_price_id
STRIPE_PREMIUM_ANNUAL_PRICE_ID_EUR=price_your_annual_eur_price_id

# Stripe Price IDs for RON (Romanian Leu - Used for RO locale)
STRIPE_PREMIUM_PRICE_ID_RON=price_your_monthly_ron_price_id
STRIPE_PREMIUM_ANNUAL_PRICE_ID_RON=price_your_annual_ron_price_id

# Public site origin, used for canonical URLs, Open Graph tags, sitemap and
# robots. Defaults to the production domain if unset.
NEXT_PUBLIC_SITE_URL=https://smartpdfnotes.com

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
# Generate a strong secret, e.g. `openssl rand -base64 32`
NEXTAUTH_SECRET=your_nextauth_secret_here

# Google OAuth (required for "Sign in with Google")
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Database Configuration
DATABASE_URL=your_database_url_here

# Email Configuration (Resend)
# Sign up at https://resend.com and get your API key from https://resend.com/api-keys
# Free tier includes 3,000 emails/month and 100 emails/day
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@yourdomain.com

# ============================================
# AI PROVIDERS
# ============================================
# OpenAI is the primary provider (required).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk_your_openai_api_key_here

# Anthropic is the fallback provider (optional).
# If unset, the summarization pipeline runs on OpenAI alone.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant_your_anthropic_api_key_here

# Optional model overrides (defaults shown)
# OPENAI_SECONDARY_MODEL=gpt-4o-mini
# ANTHROPIC_FALLBACK_MODEL=claude-opus-4-8

# ============================================
# CACHING & RATE LIMITING (Upstash Redis)
# ============================================
# Optional. Without these, the app falls back to per-instance in-memory
# caching and rate limiting (fine for local dev, not for production).
# Create a database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here
